{% extends "base.html.jinja2" %}
{% set root_path = "../" %}

{% block title %}{{ paper.title }} · {{ site.name }}{% endblock %}
{% block description %}{{ paper.problem }}{% endblock %}

{% block content %}
<div class="breadcrumb">
  <a href="{{ root_path }}index.html">All Papers</a>
  <span>›</span>
  {{ paper.title | truncate(60) }}
</div>

<div class="paper-layout">
  <!-- Main content -->
  <article>
    <div style="margin-bottom: 1.25rem;">
      <h1 style="font-size: 1.4rem; line-height: 1.35; margin-bottom: .75rem;">
        {{ paper.title }}
        {% if paper.award %}
          <span class="tag tag-award" style="vertical-align: middle; margin-left: .5rem;">★ {{ paper.award }}</span>
        {% endif %}
      </h1>

      <div style="font-size: .875rem; color: var(--text2); margin-bottom: .75rem;">
        {{ paper.authors | join(", ") }}
        {% if paper.organizations %}
          · <em>{{ paper.organizations | join(", ") }}</em>
        {% endif %}
      </div>

      {% if paper.key_results %}
      <div class="result-box">
        <strong>Key Results</strong>
        {{ paper.key_results }}
      </div>
      {% endif %}

      {% if paper.problem %}
      <div style="font-size: .9rem; color: var(--text2); font-style: italic; border-left: 3px solid var(--border); padding-left: .85rem; margin-bottom: 1rem;">
        {{ paper.problem }}
      </div>
      {% endif %}

      <!-- Insights: full labels with descriptions, before the compact tags -->
      {% if paper.insights %}
      <div class="insights-list" style="margin-bottom: .85rem;">
        {% for i in paper.insights %}
          {% set ins = insights.get(i) %}
          <a href="{{ root_path }}insights/{{ i }}.html" class="insight-item">
            {{ ins.label if ins else i }}
            {% if ins and ins.description %}
              <span class="insight-desc">{{ ins.description | truncate(120) }}</span>
            {% endif %}
          </a>
        {% endfor %}
      </div>
      {% endif %}

      <!-- Compact tags: domains, techniques, metadata -->
      <div class="tags">
        {% for d in paper.domain or [] %}
          <a href="{{ root_path }}domains/{{ d }}.html" class="tag tag-domain">{{ domains[d].label if d in domains else d }}</a>
        {% endfor %}
        {% for t in paper.techniques or [] %}
          <a href="{{ root_path }}techniques/{{ t }}.html" class="tag tag-technique">{{ techniques[t].label if t in techniques else t }}</a>
        {% endfor %}
        {% if paper.research_or_industry %}
          <span class="tag tag-{{ paper.research_or_industry }}">{{ paper.research_or_industry | capitalize }}</span>
        {% endif %}
      </div>
    </div>

    <div class="paper-body">
      {{ paper.body_html | safe }}
    </div>
  </article>

  <!-- Sidebar -->
  <aside class="sidebar card">
    {% if paper.mlsys_url or paper.openreview_url or paper.arxiv_url or paper.code_url or paper.project_url or paper.slides_url %}
    <div class="sidebar-section">
      <h3>Links</h3>
      <ul class="link-list">
        {% if paper.openreview_url %}
          <li><a href="{{ paper.openreview_url.replace('/forum?id=', '/pdf?id=') }}" target="_blank" rel="noopener">Paper (PDF)</a></li>
        {% endif %}
        {% if paper.arxiv_url %}
          <li><a href="{{ paper.arxiv_url }}" target="_blank" rel="noopener">Preprint (arXiv)</a></li>
        {% endif %}
        {% if paper.slides_url %}
          <li><a href="{{ paper.slides_url }}" target="_blank" rel="noopener">Slides</a></li>
        {% endif %}
        {% if paper.code_url %}
          <li><a href="{{ paper.code_url }}" target="_blank" rel="noopener">Code</a></li>
        {% endif %}
        {% if paper.project_url %}
          <li><a href="{{ paper.project_url }}" target="_blank" rel="noopener">Project page</a></li>
        {% endif %}
        {% if paper.mlsys_url %}
          <li><a href="{{ paper.mlsys_url }}" target="_blank" rel="noopener">MLSys virtual (login req.)</a></li>
        {% endif %}
      </ul>
    </div>
    {% endif %}

    <div class="sidebar-section">
      <h3>Details</h3>
      {% if paper.venue and paper.venue in venues %}
        {% set v = venues[paper.venue] %}
        <div class="meta-row"><span class="label">Venue</span><span class="value"><a href="{{ v.url }}" target="_blank" rel="noopener">{{ v.short }}</a></span></div>
      {% endif %}
      {% if paper.date %}
      <div class="meta-row"><span class="label">Date</span><span class="value">{{ paper.date }}</span></div>
      {% endif %}
      {% if paper.presentation_type %}
      {% set venue_short = venues[paper.venue].short if paper.venue and paper.venue in venues else "" %}
      <div class="meta-row"><span class="label">Type</span><span class="value">{{ (venue_short + " " if venue_short else "") + (paper.presentation_type | capitalize) }}</span></div>
      {% endif %}
      {% if paper.mlsys_official_category %}
      <div class="meta-row"><span class="label">Track</span><span class="value">{{ paper.mlsys_official_category }}</span></div>
      {% endif %}
      {% if paper.hardware %}
      <div class="meta-row"><span class="label">Hardware</span><span class="value">{{ paper.hardware | join(", ") }}</span></div>
      {% endif %}
      {% if paper.models_evaluated %}
      <div class="meta-row"><span class="label">Models</span><span class="value">{{ paper.models_evaluated | join(", ") }}</span></div>
      {% endif %}
      {% if paper.agentic_models %}
      <div class="meta-row"><span class="label">Agents</span><span class="value">{{ paper.agentic_models | join(", ") }}</span></div>
      {% endif %}
      {% if paper.citations is not none %}
      <div class="meta-row"><span class="label">Citations</span><span class="value">{{ paper.citations }}{% if paper.citations_updated %} <span style="color:var(--text3);font-size:.75rem;">({{ paper.citations_updated }})</span>{% endif %}</span></div>
      {% endif %}
    </div>

    <div class="sidebar-section">
      <h3>Reading</h3>
      <div class="meta-row">
        <span class="label">Status</span>
        <span class="value" style="text-transform: capitalize;">{{ paper.reading_status or "—" }}</span>
      </div>
      <div class="meta-row"><span class="label">By</span><span class="value">{{ paper.indexed_by or "—" }}</span></div>
      <div class="meta-row"><span class="label">Indexed</span><span class="value">{{ paper.indexed_date or "—" }}</span></div>
    </div>

    {% set related = [] %}
    {% for p in all_papers %}
      {% if p.slug != paper.slug %}
        {% for d in (p.domain or []) %}
          {% if d in (paper.domain or []) and p not in related %}
            {% set _ = related.append(p) %}
          {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
    {% if related %}
    <div class="sidebar-section">
      <h3>Same Domain</h3>
      {% for p in related[:4] %}
        <div style="font-size: .8rem; margin-bottom: .4rem;"><a href="{{ p.slug }}.html">{{ p.title | truncate(55) }}</a></div>
      {% endfor %}
    </div>
    {% endif %}
  </aside>
</div>
{% endblock %}
