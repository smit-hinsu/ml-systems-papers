{% extends "base.html.jinja2" %}
{% set root_path = "../" %}

{% block title %}{{ paper.title }} · {{ site.name }}{% endblock %}
{% block description %}{{ paper.problem }}{% endblock %}

{% block content %}
<div class="breadcrumb">
  <a href="{{ root_path }}index.html">All Papers</a>
  <span>›</span>
  {{ paper.title | truncate(60) }}
</div>

<div class="paper-layout">
  <!-- Main content -->
  <article>
    <div style="margin-bottom: 1.25rem;">
      <h1 style="font-size: 1.4rem; line-height: 1.35; margin-bottom: .75rem;">
        {{ paper.title }}
        {% if paper.award %}
          <span class="tag tag-award" style="vertical-align: middle; margin-left: .5rem;">★ {{ paper.award }}</span>
        {% endif %}
        {% if dev_mode and paper.status in ['draft', 'under-review'] %}
          <span class="tag tag-{{ 'draft' if paper.status == 'draft' else 'review' }}" style="vertical-align: middle; margin-left: .5rem;">{{ paper.status }}</span>
        {% endif %}
      </h1>

      <div style="font-size: .875rem; color: var(--text2); margin-bottom: .75rem;
                  display: flex; flex-wrap: nowrap; align-items: center; gap: .3rem;
                  overflow: hidden; min-width: 0;">
        {% if paper.authors %}
        <span style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0;">
          {{ paper.authors[:2] | join(", ") }}{% if paper.authors | length > 2 %} et al.{% endif %}
        </span>
        {% endif %}
        {% for org in (paper.organizations or [])[:2] %}
          <a href="{{ root_path }}index.html?organization={{ org | urlencode }}"
             class="tag tag-org" style="flex-shrink: 0; white-space: nowrap;">{{ org }}</a>
        {% endfor %}
        {% if (paper.organizations or []) | length > 2 %}
          <span style="font-size:.75rem; color:var(--text3); flex-shrink: 0; white-space: nowrap;">
            +{{ (paper.organizations | length) - 2 }} more
          </span>
        {% endif %}
        {% if paper.arxiv_date %}
          <span style="color:var(--text3); flex-shrink: 0; white-space: nowrap;">{{ paper.arxiv_date }}</span>
        {% endif %}
      </div>

      {% if paper.key_results %}
      <div class="result-box">
        <strong>Key Results</strong>
        {{ paper.key_results }}
      </div>
      {% endif %}

      <!-- Compact tags: domains, topics, optimization type -->
      <div class="tags">
        {% for d in paper.domain or [] %}
          <a href="{{ root_path }}index.html?domain={{ d }}" class="tag tag-domain">{{ domains[d].label if d in domains else d }}</a>
        {% endfor %}
        {% for t in paper.topics or [] %}
          <a href="{{ root_path }}index.html?topic={{ t }}" class="tag tag-topic">{{ topics[t].label if t in topics else t }}</a>
        {% endfor %}
        {% for ot in paper.optimization_type or [] %}
          <a href="{{ root_path }}index.html?opttype={{ ot }}" class="tag tag-opttype">{{ optimization_types[ot].label if ot in optimization_types else ot }}</a>
        {% endfor %}
      </div>
    </div>

    <div class="paper-body" id="paper-body">
      {% if paper.principles %}
      <h2>Observations</h2>
      <ul>
        {% for i in paper.principles %}
          {% set pr = principles.get(i) %}
          {% set obs = (paper.observations or {}).get(i) %}
          <li>
            <a href="{{ root_path }}index.html?principle={{ i }}"><strong>{{ (pr.short or pr.label) if pr else i }}</strong></a>
            {% if obs %} — {{ obs }}{% endif %}
          </li>
        {% endfor %}
      </ul>
      {% endif %}
      {{ paper.body_html | safe }}
    </div>
    <script>
    (function() {
      const body = document.getElementById('paper-body');
      if (!body) return;
      const headings = Array.from(body.querySelectorAll('h2'));
      const bgH2 = headings.find(h => h.textContent.trim() === 'Background');
      if (!bgH2) return;
      const wrapper = document.createElement('div');
      wrapper.style.cssText = 'background:#f0f9ff;border:1px solid #bae6fd;border-radius:6px;padding:.85rem 1.1rem;margin:1.25rem 0;';
      bgH2.parentNode.insertBefore(wrapper, bgH2);
      wrapper.appendChild(bgH2);
      let next = wrapper.nextSibling;
      while (next && !(next.nodeType === 1 && next.tagName === 'H2')) {
        const following = next.nextSibling;
        wrapper.appendChild(next);
        next = following;
      }
      // Move Background callout to before Observations (or to top of body if no Observations)
      const obsH2 = Array.from(body.querySelectorAll('h2')).find(h => h.textContent.trim() === 'Observations');
      body.insertBefore(wrapper, obsH2 || body.firstChild);
    })();
    </script>
  </article>

  <!-- Sidebar -->
  <aside class="sidebar card">
    {% if paper.venue_url or paper.openreview_url or paper.arxiv_url or paper.code_url or paper.project_url or paper.slides_url %}
    <div class="sidebar-section">
      <h3>Links</h3>
      <ul class="link-list">
        {% set paper_url = paper.arxiv_url or paper.openreview_url.replace('/forum?id=', '/pdf?id=') if paper.openreview_url else "" %}
        {% if paper_url %}
          <li><a href="{{ paper_url }}" target="_blank" rel="noopener">Paper</a></li>
        {% endif %}
        {% if paper.slides_url %}
          <li><a href="{{ paper.slides_url }}" target="_blank" rel="noopener">Slides</a></li>
        {% endif %}
        {% if paper.code_url %}
          <li><a href="{{ paper.code_url }}" target="_blank" rel="noopener">{{ paper.code_label or "Code" }}</a></li>
        {% endif %}
        {% if paper.project_url %}
          <li><a href="{{ paper.project_url }}" target="_blank" rel="noopener">Project page</a></li>
        {% endif %}
        {% if paper.venue_url %}
          {% set venue_short = venues[paper.venue].short if paper.venue and paper.venue in venues else "Conference site" %}
          <li><a href="{{ paper.venue_url }}" target="_blank" rel="noopener">{{ venue_short }} (login req.)</a></li>
        {% endif %}
      </ul>
    </div>
    {% endif %}

    <div class="sidebar-section">
      <h3>Details</h3>
      {% if paper.venue and paper.venue in venues %}
        {% set v = venues[paper.venue] %}
        <div class="meta-row"><span class="label">Venue</span><span class="value"><a href="{{ v.url }}" target="_blank" rel="noopener">{{ v.short }}</a></span></div>
      {% endif %}
      {% if paper.hardware %}
      <div class="meta-row"><span class="label">Hardware</span><span class="value">{{ paper.hardware | join(", ") }}</span></div>
      {% endif %}
      {% if paper.models_evaluated %}
      <div class="meta-row"><span class="label">Models</span><span class="value">{{ paper.models_evaluated | join(", ") }}</span></div>
      {% endif %}
      {% if paper.agentic_models %}
      <div class="meta-row"><span class="label">Agents</span><span class="value">{{ paper.agentic_models | join(", ") }}</span></div>
      {% endif %}
      {% if paper.citations is not none %}
      <div class="meta-row"><span class="label">Citations</span><span class="value">{{ paper.citations }}{% if paper.citations_updated %} <span style="color:var(--text3);font-size:.75rem;">({{ paper.citations_updated }})</span>{% endif %}</span></div>
      {% endif %}
    </div>

  </aside>
</div>
{% endblock %}
