{% extends "base.html.jinja2" %}
{% set root_path = "../" %}

{% block title %}Browse · {{ site.name }}{% endblock %}

{% block content %}
<div class="breadcrumb">
  <a href="{{ root_path }}index.html">All Papers</a>
  <span>›</span>
  Browse
</div>

<h1 style="font-size: 1.4rem; margin-bottom: .35rem;">Browse</h1>
<p style="color: var(--text2); font-size: .9rem; margin-bottom: 1.75rem;">
  Every dimension the index can be filtered or searched by. Each value opens the paper
  list filtered to it.
</p>

{% for facet in facets %}
  {% if facet.options %}
  <section style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.05rem; margin-bottom: .2rem;">
      {{ facet.label }}
      <span class="count-badge">{{ facet.options | length }}</span>
    </h2>
    <p style="color: var(--text3); font-size: .8rem; margin: 0 0 .7rem;">{{ facet.hint }}</p>
    <div class="tags" style="gap: .35rem;">
      {% for v in facet.options %}
        <a href="{{ root_path }}index.html?{{ facet.param }}={{ v.value | urlencode }}"
           class="tag tag-{{ facet.chip }}"
           title="{{ v.title }}">{{ v.label }} <span style="opacity:.6;">{{ v.count }}</span></a>
      {% endfor %}
    </div>
  </section>
  {% endif %}
{% endfor %}
{% endblock %}
