{% extends "base.html.jinja2" %}
{% set root_path = "" %}

{% block title %}{{ site.name }}{% endblock %}

{% block content %}
<div class="hero">
  <h1>{{ site.name }}</h1>
  <p style="color: var(--text2);">{{ site.tagline }}</p>
  <div class="stats">
    <div class="stat"><span class="num" id="stat-papers">{{ all_papers | length }}</span>papers</div>
  </div>
</div>

<!-- Search + filter bar -->
<div style="margin-bottom:1rem;">
  <div style="position:relative;">
    <input id="search-input" type="search"
      placeholder="Search title, author, organization, domain, hardware, topic…"
      oninput="onSearch(this.value)"
      style="width:100%; padding:.65rem 1rem .65rem 2.4rem; font-size:.95rem;
             border:1.5px solid var(--border); border-radius:var(--radius);
             background:#fff; color:var(--text); outline:none;">
    <svg style="position:absolute;left:.7rem;top:50%;transform:translateY(-50%);
                width:1rem;height:1rem;color:var(--text3);pointer-events:none;"
         fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
  </div>
</div>

<!-- Active filter status -->
<div style="display:flex; align-items:baseline; gap:1rem; margin-bottom:.75rem; flex-wrap:wrap; min-height:1.5rem;">
  <span id="filter-status" style="font-size:.85rem; color:var(--text2);"></span>
  <button id="clear-btn" onclick="clearAll()"
    style="display:none; font-size:.75rem; padding:.2em .6em; border:1px solid var(--border);
           border-radius:999px; background:#fff; color:var(--text2); cursor:pointer;">
    × clear
  </button>
</div>

<div class="paper-grid" id="paper-grid">
{% for paper in all_papers | sort(attribute='title') %}
  <div class="card paper-card"
       data-slug="{{ paper.slug }}"
       data-domains="{{ (paper.domain or []) | join(' ') }}"
       data-observations="{{ (paper.observations or []) | join(' ') }}"
       data-topics="{{ (paper.topics or []) | join(' ') }}"
       data-organizations="{{ (paper.organizations or []) | join('|') }}">
    <div class="card-title"><a href="papers/{{ paper.slug }}.html">{{ paper.title }}</a></div>
    <div class="card-meta" style="display:flex; flex-wrap:wrap; align-items:center; gap:.35rem;">
      {% if paper.authors %}
        <span>{{ paper.authors[0].split()[-1] }}{% if paper.authors | length > 1 %} et al.{% endif %}</span>
      {% endif %}
      {% for org in (paper.organizations or [])[:2] %}
        <a href="#" class="tag tag-org" data-filter-type="organization" data-filter-value="{{ org }}">{{ org }}</a>
      {% endfor %}
      {% if (paper.organizations or []) | length > 2 %}
        <span style="font-size:.75rem; color:var(--text3);">etc.</span>
      {% endif %}
      {% if paper.venue and paper.venue in venues %}
        <span style="color:var(--text3);">{{ venues[paper.venue].short }}</span>
      {% endif %}
    </div>
    {% if paper.problem %}
      <div class="card-problem">{{ paper.problem }}</div>
    {% endif %}
    {% if paper.key_results %}
      <div class="card-results"><strong>↗</strong> {{ paper.key_results }}</div>
    {% endif %}
    {% if paper.observations %}
      <div class="observations-list" style="margin-bottom:.6rem;">
        {% for i in paper.observations %}
          <a href="#" class="observation-item-sm" data-filter-type="observation" data-filter-value="{{ i }}">
            {{ observations[i].label if i in observations else i }}
          </a>
        {% endfor %}
      </div>
    {% endif %}
    <div class="tags">
      {% for d in paper.domain or [] %}
        <a href="#" class="tag tag-domain" data-filter-type="domain" data-filter-value="{{ d }}">{{ domains[d].label if d in domains else d }}</a>
      {% endfor %}
      {% for t in paper.topics or [] %}
        <a href="#" class="tag tag-topic" data-filter-type="topic" data-filter-value="{{ t }}">{{ topics[t].label if t in topics else t }}</a>
      {% endfor %}
      {% if paper.award %}<span class="tag tag-award">★ {{ paper.award }}</span>{% endif %}
    </div>
  </div>
{% endfor %}
</div>

<script>
const LABELS = {
  domain:       { {% for slug, d in domains.items() %}"{{ slug }}": "{{ d.label }}", {% endfor %} },
  observation:  { {% for slug, ins in observations.items() %}"{{ slug }}": {{ ins.label | tojson }}, {% endfor %} },
  topic:        { {% for slug, t in topics.items() %}"{{ slug }}": "{{ t.label }}", {% endfor %} },
  organization: { {% for paper in all_papers %}{% for org in paper.organizations or [] %}"{{ org }}": "{{ org }}", {% endfor %}{% endfor %} },
};
const TOTAL = document.querySelectorAll('.paper-card').length;

// ── state ──────────────────────────────────────────────────────────────────────
let activeType = null, activeValue = null, activeSearch = null;

// ── helpers ────────────────────────────────────────────────────────────────────
function setVisible(predicate) {
  let n = 0;
  document.querySelectorAll('.paper-card').forEach(c => {
    const show = predicate(c);
    c.style.display = show ? '' : 'none';
    if (show) n++;
  });
  document.getElementById('stat-papers').textContent = n;
  return n;
}

function setStatus(text, show) {
  document.getElementById('filter-status').textContent = text;
  document.getElementById('clear-btn').style.display = show ? '' : 'none';
}

// ── tag filter ─────────────────────────────────────────────────────────────────
function applyFilter(type, value) {
  activeType = type; activeValue = value; activeSearch = null;
  document.getElementById('search-input').value = '';
  const sep = type === 'organization' ? '|' : ' ';
  setVisible(c => (c.dataset[type + 's'] || '').split(sep).includes(value));
  setStatus(`Filtered by: ${LABELS[type]?.[value] || value}`, true);
  document.querySelectorAll('[data-filter-type]').forEach(el => {
    el.style.outline = (el.dataset.filterType === type && el.dataset.filterValue === value)
      ? '2px solid var(--accent)' : '';
  });
  history.replaceState({}, '', `?${type}=${encodeURIComponent(value)}`);
}

// ── search ─────────────────────────────────────────────────────────────────────
const PAPERS = {{ search_index | tojson }};
</script>
<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>
<script>
const fuse = new Fuse(PAPERS, {
  keys: [
    { name: "title",            weight: 3 },
    { name: "problem",          weight: 2 },
    { name: "observation_labels",   weight: 2 },
    { name: "key_results",      weight: 1.5 },
    { name: "authors",          weight: 1 },
    { name: "organizations",    weight: 0.8 },
    { name: "domain_labels",    weight: 0.8 },
    { name: "topic_labels", weight: 0.8 },
    { name: "hardware",         weight: 0.8 },
  ],
  threshold: 0.2,
  includeScore: true,
  minMatchCharLength: 2,
});

function onSearch(q) {
  q = q.trim();
  if (!q) { clearAll(); return; }

  activeSearch = q; activeType = activeValue = null;
  document.querySelectorAll('[data-filter-type]').forEach(el => el.style.outline = '');

  const hits = new Set(fuse.search(q).map(r => r.item.slug));
  const n = setVisible(c => hits.has(c.dataset.slug));
  setStatus(`${n} result${n !== 1 ? 's' : ''} for "${q}"`, true);
  history.replaceState({}, '', `?q=${encodeURIComponent(q)}`);
}

// ── clear ──────────────────────────────────────────────────────────────────────
function clearAll() {
  activeType = activeValue = activeSearch = null;
  document.getElementById('search-input').value = '';
  setVisible(() => true);
  setStatus('', false);
  document.querySelectorAll('[data-filter-type]').forEach(el => el.style.outline = '');
  history.replaceState({}, '', location.pathname);
}

// ── tag click delegation ───────────────────────────────────────────────────────
document.addEventListener('click', e => {
  const el = e.target.closest('[data-filter-type]');
  if (!el) return;
  e.preventDefault();
  const { filterType: type, filterValue: value } = el.dataset;
  if (activeType === type && activeValue === value) clearAll();
  else applyFilter(type, value);
});

// ── restore from URL ───────────────────────────────────────────────────────────
const params = new URLSearchParams(location.search);
const q = params.get('q');
if (q) { document.getElementById('search-input').value = q; onSearch(q); }
else {
  for (const type of ['domain', 'observation', 'topic', 'organization']) {
    const val = params.get(type);
    if (val) { applyFilter(type, val); break; }
  }
}
</script>
{% endblock %}
