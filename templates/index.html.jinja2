{% extends "base.html.jinja2" %}
{% set root_path = "" %}

{% block title %}{{ site.name }}{% endblock %}

{% block content %}
<!-- Compact hero -->
<div style="display:flex; align-items:baseline; gap:.75rem; flex-wrap:wrap; margin-bottom:.6rem;">
  <span style="font-size:1.2rem; font-weight:700; color:var(--text);">{{ site.name }}</span>
  <span style="color:var(--text2); font-size:.875rem;">{{ site.tagline }}</span>
  <span class="count-badge" id="stat-papers">{{ all_papers | length }} papers</span>
</div>

<!-- Search + filter bar -->
<div style="margin-bottom:1rem;">
  <div style="position:relative;">
    <input id="search-input" type="search"
      placeholder="Search title, author, organization, domain, hardware, topic…"
      oninput="onSearch(this.value)"
      style="width:100%; padding:.65rem 1rem .65rem 2.4rem; font-size:.95rem;
             border:1.5px solid var(--border); border-radius:var(--radius);
             background:#fff; color:var(--text); outline:none;">
    <svg style="position:absolute;left:.7rem;top:50%;transform:translateY(-50%);
                width:1rem;height:1rem;color:var(--text3);pointer-events:none;"
         fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
    </svg>
  </div>
</div>

<!-- Active filter strip -->
<div id="filter-strip" style="display:none; align-items:center; gap:.5rem; margin-bottom:.75rem; flex-wrap:wrap; min-height:1.75rem;">
  <span style="font-size:.75rem; color:var(--text3); font-weight:600; text-transform:uppercase; letter-spacing:.04em;">Filtered by</span>
  <span id="active-chip" style="
    display:inline-flex; align-items:center; gap:.35rem;
    font-size:.75rem; font-weight:600; padding:.25em .65em;
    border-radius:999px; cursor:pointer; user-select:none;">
    <span id="active-chip-label"></span>
    <span style="font-size:.85em; opacity:.7;">×</span>
  </span>
  <span id="result-count" style="font-size:.8rem; color:var(--text3);"></span>
</div>
<div id="search-strip" style="display:none; align-items:center; gap:.5rem; margin-bottom:.75rem;">
  <span id="search-status" style="font-size:.85rem; color:var(--text2);"></span>
  <button onclick="clearAll()"
    style="font-size:.75rem; padding:.2em .6em; border:1px solid var(--border);
           border-radius:999px; background:#fff; color:var(--text2); cursor:pointer;">
    × clear
  </button>
</div>

<div class="paper-grid" id="paper-grid">
{% for paper in all_papers %}
  <div class="card paper-card"
       data-slug="{{ paper.slug }}"
       data-domains="{{ (paper.domain or []) | join(' ') }}"
       data-principles="{{ (paper.principles or []) | join(' ') }}"
       data-topics="{{ (paper.topics or []) | join(' ') }}"
       data-organizations="{{ (paper.organizations or []) | join('|') }}">
    <div class="card-title"><a href="papers/{{ paper.slug }}.html">{{ paper.title }}</a></div>
    {% set orgs = paper.organizations or [] %}
    {% set orgs_init_hidden = [orgs | length - 2, 0] | max %}
    <div class="card-meta" style="display:flex; flex-wrap:nowrap; align-items:center; gap:.35rem; overflow:hidden; min-width:0;">
      {% if paper.authors %}
        <span class="meta-authors" style="white-space:nowrap; flex-shrink:1; min-width:0; overflow:hidden; text-overflow:ellipsis;">{% for a in paper.authors %}{% if not loop.first %}<span class="meta-author-sep">, </span>{% endif %}<span class="meta-author">{{ a.split()[-1] }}</span>{% endfor %}<span class="meta-etal" style="display:none;"> et al.</span></span>
      {% endif %}
      {% for org in orgs[:2] %}
        <a href="#" class="tag tag-org meta-org" style="flex-shrink:0; white-space:nowrap;" data-filter-type="organization" data-filter-value="{{ org }}">{{ org }}</a>
      {% endfor %}
      <span class="meta-org-more" style="font-size:.75rem; color:var(--text3); flex-shrink:0; white-space:nowrap;{% if orgs_init_hidden == 0 %} display:none;{% endif %}">{% if orgs_init_hidden > 0 %}+{{ orgs_init_hidden }} more{% endif %}</span>
      {% if paper.venue and paper.venue in venues %}
        <span style="color:var(--text3); flex-shrink:0; white-space:nowrap;">{{ venues[paper.venue].short }}</span>
      {% endif %}
    </div>
    <!-- Domain + topic tags immediately after meta -->
    {% set has_tags = (paper.domain or []) or (paper.topics or []) or paper.award or paper.status in ['under-review', 'draft'] %}
    {% if has_tags %}
    <div class="tags" style="margin-bottom:.5rem;">
      {% for d in paper.domain or [] %}
        <a href="#" class="tag tag-domain" data-filter-type="domain" data-filter-value="{{ d }}">{{ domains[d].label if d in domains else d }}</a>
      {% endfor %}
      {% for t in paper.topics or [] %}
        <a href="#" class="tag tag-topic" data-filter-type="topic" data-filter-value="{{ t }}">{{ topics[t].label if t in topics else t }}</a>
      {% endfor %}
      {% if paper.award %}<span class="tag tag-award">★ {{ paper.award }}</span>{% endif %}
      {% if paper.status == 'under-review' %}<span class="tag tag-review dev-badge" style="display:none;">reviewing</span>{% endif %}
      {% if paper.status == 'draft' %}<span class="tag tag-draft dev-badge" style="display:none;">draft</span>{% endif %}
    </div>
    {% endif %}
    {% if paper.key_results %}
      <div class="card-results"><strong>↗</strong> {{ paper.key_results }}</div>
    {% endif %}
    <!-- Principles section after key results -->
    {% if paper.principles %}
    <div class="tags" style="margin-top:.4rem;">
      {% for i in paper.principles or [] %}
        <a href="#" class="tag tag-principle" data-filter-type="principle" data-filter-value="{{ i }}">{{ principles[i].label if i in principles else i }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
{% endfor %}
</div>

<script>
const LABELS = {
  domain:       { {% for slug, d in domains.items() %}"{{ slug }}": "{{ d.label }}", {% endfor %} },
  principle:    { {% for slug, p in principles.items() %}"{{ slug }}": {{ p.label | tojson }}, {% endfor %} },
  topic:        { {% for slug, t in topics.items() %}"{{ slug }}": "{{ t.label }}", {% endfor %} },
  organization: { {% for paper in all_papers %}{% for org in paper.organizations or [] %}"{{ org }}": "{{ org }}", {% endfor %}{% endfor %} },
};
const TOTAL = document.querySelectorAll('.paper-card').length;

// ── state ──────────────────────────────────────────────────────────────────────
let activeType = null, activeValue = null, activeSearch = null;

// ── helpers ────────────────────────────────────────────────────────────────────
function setVisible(predicate) {
  let n = 0;
  document.querySelectorAll('.paper-card').forEach(c => {
    const show = predicate(c);
    c.style.display = show ? '' : 'none';
    if (show) n++;
  });
  document.getElementById('stat-papers').textContent = n;
  return n;
}

// ── chip colours per filter type ───────────────────────────────────────────────
const CHIP_STYLE = {
  domain:       { bg: 'var(--tag-domain-bg)',       color: 'var(--tag-domain)' },
  principle:    { bg: 'var(--tag-observation-bg)',  color: 'var(--tag-observation)' },
  topic:        { bg: 'var(--tag-topic-bg)',         color: 'var(--tag-topic)' },
  organization: { bg: '#f1f5f9',                     color: '#475569' },
};

function showFilterChip(type, value, n) {
  const strip = document.getElementById('filter-strip');
  const chip  = document.getElementById('active-chip');
  const label = document.getElementById('active-chip-label');
  const count = document.getElementById('result-count');
  const s = CHIP_STYLE[type] || CHIP_STYLE.organization;
  chip.style.background = s.bg;
  chip.style.color = s.color;
  label.textContent = LABELS[type]?.[value] || value;
  count.textContent = `${n} paper${n !== 1 ? 's' : ''}`;
  strip.style.display = 'flex';
  document.getElementById('search-strip').style.display = 'none';
}

function hideStrips() {
  document.getElementById('filter-strip').style.display = 'none';
  document.getElementById('search-strip').style.display = 'none';
}

// ── tag filter ─────────────────────────────────────────────────────────────────
function applyFilter(type, value) {
  activeType = type; activeValue = value; activeSearch = null;
  document.getElementById('search-input').value = '';
  const sep = type === 'organization' ? '|' : ' ';
  const n = setVisible(c => (c.dataset[type + 's'] || '').split(sep).includes(value));
  showFilterChip(type, value, n);
  document.querySelectorAll('[data-filter-type]').forEach(el => {
    el.style.outline = (el.dataset.filterType === type && el.dataset.filterValue === value)
      ? '2px solid var(--accent)' : '';
  });
  history.replaceState({}, '', `?${type}=${encodeURIComponent(value)}`);
}

// ── search ─────────────────────────────────────────────────────────────────────
const PAPERS = {{ search_index | tojson }};
</script>
<script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>
<script>
const fuse = new Fuse(PAPERS, {
  keys: [
    { name: "title",            weight: 3 },
    { name: "problem",          weight: 2 },
    { name: "principle_labels",      weight: 2 },
    { name: "key_results",      weight: 1.5 },
    { name: "authors",          weight: 1 },
    { name: "organizations",    weight: 0.8 },
    { name: "domain_labels",    weight: 0.8 },
    { name: "topic_labels", weight: 0.8 },
    { name: "hardware",         weight: 0.8 },
  ],
  threshold: 0.2,
  includeScore: true,
  minMatchCharLength: 2,
});

function onSearch(q) {
  q = q.trim();
  if (!q) { clearAll(); return; }

  activeSearch = q; activeType = activeValue = null;
  document.querySelectorAll('[data-filter-type]').forEach(el => el.style.outline = '');

  const hits = new Set(fuse.search(q).map(r => r.item.slug));
  const n = setVisible(c => hits.has(c.dataset.slug));
  document.getElementById('search-status').textContent = `${n} result${n !== 1 ? 's' : ''} for "${q}"`;
  document.getElementById('search-strip').style.display = 'flex';
  document.getElementById('filter-strip').style.display = 'none';
  history.replaceState({}, '', `?q=${encodeURIComponent(q)}`);
}

// ── clear ──────────────────────────────────────────────────────────────────────
function clearAll() {
  activeType = activeValue = activeSearch = null;
  document.getElementById('search-input').value = '';
  setVisible(() => true);
  hideStrips();
  document.getElementById('stat-papers').textContent = TOTAL;
  document.querySelectorAll('[data-filter-type]').forEach(el => el.style.outline = '');
  history.replaceState({}, '', location.pathname);
}

// ── filter chip click ─────────────────────────────────────────────────────────
document.getElementById('active-chip').addEventListener('click', clearAll);

// ── tag click delegation ───────────────────────────────────────────────────────
document.addEventListener('click', e => {
  const el = e.target.closest('[data-filter-type]');
  if (!el) return;
  e.preventDefault();
  const { filterType: type, filterValue: value } = el.dataset;
  if (activeType === type && activeValue === value) clearAll();
  else applyFilter(type, value);
});

// ── restore from URL ───────────────────────────────────────────────────────────
const params = new URLSearchParams(location.search);
const q = params.get('q');
if (q) { document.getElementById('search-input').value = q; onSearch(q); }
else {
  for (const type of ['domain', 'principle', 'topic', 'organization']) {
    const val = params.get(type);
    if (val) { applyFilter(type, val); break; }
  }
}

// ── dynamic meta-row fitting ───────────────────────────────────────────────────
const PAPER_MAP = Object.fromEntries(PAPERS.map(p => [p.slug, p]));

function fitMetaRow(card) {
  const meta = card.querySelector('.card-meta');
  if (!meta || meta.scrollWidth <= meta.clientWidth) return;

  const paper = PAPER_MAP[card.dataset.slug];
  if (!paper) return;

  const orgEls = [...meta.querySelectorAll('.meta-org')];
  const orgMoreEl = meta.querySelector('.meta-org-more');
  const authorEls = [...meta.querySelectorAll('.meta-author')];
  const sepEls = [...meta.querySelectorAll('.meta-author-sep')]; // sepEls[i] precedes authorEls[i+1]
  const etAlEl = meta.querySelector('.meta-etal');
  const totalOrgs = paper.organizations.length;
  let shownOrgs = orgEls.length;

  // Trim org chips right-to-left, incrementing "+N more"
  while (meta.scrollWidth > meta.clientWidth && shownOrgs > 0) {
    shownOrgs--;
    orgEls[shownOrgs].style.display = 'none';
    if (orgMoreEl) {
      orgMoreEl.style.display = '';
      orgMoreEl.textContent = `+${totalOrgs - shownOrgs} more`;
    }
  }

  // Trim authors right-to-left (keep at least 1), showing "et al." when any hidden
  let shownAuthors = authorEls.length;
  while (meta.scrollWidth > meta.clientWidth && shownAuthors > 1) {
    const idx = shownAuthors - 1;
    shownAuthors--;
    authorEls[idx].style.display = 'none';
    if (sepEls[idx - 1]) sepEls[idx - 1].style.display = 'none'; // sep immediately before this author
    if (etAlEl) etAlEl.style.display = '';
  }
}

requestAnimationFrame(() => {
  document.querySelectorAll('.paper-card').forEach(fitMetaRow);
});

// ── dev mode (?dev=1 in URL) ───────────────────────────────────────────────────
(function() {
  const isDev = new URLSearchParams(location.search).has('dev');
  if (isDev) {
    document.querySelectorAll('.dev-badge').forEach(el => el.style.display = '');
    const banner = document.createElement('div');
    banner.style.cssText = 'position:fixed;bottom:1rem;right:1rem;background:#1e293b;color:#f8fafc;font-size:.75rem;padding:.4em .85em;border-radius:999px;z-index:99;opacity:.85;pointer-events:none;';
    banner.textContent = 'dev mode';
    document.body.appendChild(banner);
  }
})();
</script>
{% endblock %}
